# Local Vite development already defaults to http://127.0.0.1:5000.
# Set this explicitly for production builds to your deployed Flask origin.
VITE_API_BASE_URL=
# Set true only for an intentional offline UI demo.
VITE_USE_MOCK=false
# Never expose this in the frontend bundle. Configure the same value on Flask.
ADMIN_API_TOKEN=replace-with-a-long-random-value
# Comma-separated browser origins accepted by Flask in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional absolute path for a persistent SQLite file.
GADGET_GUARDIAN_DATABASE=backend/gadget_guardian.sqlite3
